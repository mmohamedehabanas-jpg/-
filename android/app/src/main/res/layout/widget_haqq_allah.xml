<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_widget_emerald"
    android:layout_direction="rtl">

    <!-- Top Row: حق الله 🕌 | 29 جمادى الأولى 1448 هـ | 📍 ميت غمر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حق الله 🕌"
            android:textColor="#FDE68A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="29 جمادى الأولى 1448 هـ"
            android:textColor="#A7F3D0"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 ميت غمر"
            android:textColor="#ECFDF5"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Section: Next Prayer & Framed Countdown + Azkar Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <!-- Right Side: Next Prayer Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متبقٍ على أذان:"
                android:textColor="#A7F3D0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صلاة الفجر"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الموعد: ٠٤:٤٦ ص"
                android:textColor="#FCD34D"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Left Side: Countdown Box & Azkar Shortcut Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Framed Countdown Box -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_countdown_box">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الوقت المتبقي"
                    android:textColor="#FDE68A"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tv_countdown_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="٤:٠٧:٢٤"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Azkar Shortcut Button -->
            <Button
                android:id="@+id/btn_widget_azkar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="الأذكار 📿"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_azkar_btn" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: 5 Prayer Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_prayer_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#A7F3D0" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٠٤:٤٦ ص" android:textColor="#FCD34D" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_prayer_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#A7F3D0" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="١١:٣٩ ص" android:textColor="#FCD34D" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_prayer_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#A7F3D0" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٠٢:٤٠ م" android:textColor="#FCD34D" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_prayer_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#A7F3D0" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٠٥:٠٢ م" android:textColor="#FCD34D" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_prayer_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#A7F3D0" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٠٦:٢٢ م" android:textColor="#FCD34D" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
